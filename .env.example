APP_ENV=http://localhost:8085/api/v1

# Must match the backend JWT_SECRET_KEY. Use a random value of at least 32 bytes.
JWT_SECRET_KEY=replace-with-the-backend-jwt-secret

# Access-token lifetime in minutes; refresh-token lifetime in days.
ACCESS_TOKEN_EXPIRY=15
REFRESH_TOKEN_EXPIRY=7

# Configure these when the backend starts issuing matching iss and aud claims.
# JWT_ISSUER=linkflow-api
# JWT_AUDIENCE=linkflow-ui

# Secure defaults to true in production. Only disable it for an HTTP-only local test server.
# AUTH_COOKIE_SECURE=false
